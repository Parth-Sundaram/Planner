{
  "manifest_version": 3,
  "name": "Add to Planner",
  "version": "1.0.0",
  "description": "Turn any page, GitHub issue or message into a task in your planner.",
  "action": { "default_popup": "popup.html", "default_title": "Add to Planner" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.onrender.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } } }
}
